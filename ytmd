#!/usr/bin/env python3
"""YouTube captions → a local, searchable transcript library. Python 3.9+, yt-dlp."""
from __future__ import annotations

import argparse
from contextlib import closing
from datetime import datetime, timezone
import html
import json
import math
import os
from pathlib import Path
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile
from urllib.parse import parse_qs, urlparse

VERSION = "0.4.0"
SCHEMA = 2
ID = re.compile(r"[A-Za-z0-9_-]{11}\Z")
LANG = re.compile(r"[A-Za-z0-9_-]+\Z")
HOSTS = {"youtube.com", "www.youtube.com", "m.youtube.com", "music.youtube.com", "youtu.be", "www.youtu.be"}


class Error(Exception):
    def __init__(self, code, message):
        self.code, self.message = code, message
        super().__init__(message)


def library():
    return Path(os.environ.get("YTMD_DIR", "~/ytmd")).expanduser().resolve()


def timestamp(seconds):
    h, s = divmod(max(0, int(seconds)), 3600)
    m, s = divmod(s, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def video_id(value):
    if ID.fullmatch(value):
        return value
    try:
        u = urlparse(value)
        valid = u.scheme in ("https", "http") and u.hostname in HOSTS and not (u.username or u.password or u.port)
    except ValueError:
        valid = False
    if not valid:
        raise Error("invalid_url", "Pass a YouTube video URL or 11-character video ID.")
    parts = u.path.strip("/").split("/")
    if u.hostname in ("youtu.be", "www.youtu.be") and len(parts) == 1:
        key = parts[0]
    elif u.path == "/watch":
        key = parse_qs(u.query).get("v", [""])[0]
    elif len(parts) == 2 and parts[0] in ("shorts", "live", "embed"):
        key = parts[1]
    else:
        key = ""
    if not ID.fullmatch(key):
        raise Error("invalid_url", "Pass a single video, not a channel or playlist.")
    return key


def url_for(key, start=None):
    url = f"https://www.youtube.com/watch?v={key}"
    return url if start is None else f"{url}&t={int(start)}s"


def normalize(text):
    return " ".join(text.split())


# JSON3 is plain text: do NOT strip angle brackets or decode entities here.
def parse_json3(raw):
    try:
        data = json.loads(raw)
    except ValueError:
        raise Error("invalid_captions", "Malformed JSON3 captions.")
    if not isinstance(data, dict) or not isinstance(data.get("events", []), list):
        raise Error("invalid_captions", "Malformed JSON3 event list.")
    cues = []
    for event in data.get("events", []):
        if not isinstance(event, dict) or not isinstance(event.get("segs", []), list):
            raise Error("invalid_captions", "Malformed JSON3 cue.")
        segs = event.get("segs", [])
        if any(not isinstance(s, dict) or not isinstance(s.get("utf8", ""), str) for s in segs):
            raise Error("invalid_captions", "Malformed JSON3 text.")
        text = normalize("".join(s.get("utf8", "") for s in segs))
        if not text:
            continue
        start = float(event.get("tStartMs", 0)) / 1000
        end = start + float(event.get("dDurationMs", 0)) / 1000
        cues.append({"start": start, "end": end, "text": text})
    return validate_cues(cues)


VTT_TIME = r"(?:\d{2,}:)?\d{2}:\d{2}\.\d{3}"
VTT_TAG = re.compile(r"</?(?:b|i|u|ruby|rt)>|</?c(?:\.[^>\s]+)*>|<v(?:\s+[^>]*)?>|</v>|<lang(?:\s+[^>]*)?>|</lang>|<" + VTT_TIME + r">")


def seconds(value):
    parts = value.split(":")
    if not 1 <= len(parts) <= 3:
        raise ValueError("Invalid timestamp")
    nums = [float(p) for p in parts]
    if any(not math.isfinite(n) or n < 0 for n in nums) or any(n >= 60 for n in nums[1:]):
        raise ValueError("Invalid timestamp")
    total = 0.0
    for n in nums:
        total = total * 60 + n
    return total


def parse_vtt(raw):
    cues = []
    previous_lines, previous_end = [], -1
    for block in re.split(r"\n[ \t]*\n", raw.lstrip("\ufeff").replace("\r\n", "\n")):
        lines = block.splitlines()
        if not lines or lines[0].startswith(("NOTE", "STYLE", "REGION", "WEBVTT")):
            continue
        timing = next((i for i, line in enumerate(lines) if "-->" in line), None)
        if timing is None:
            continue
        match = re.match(r"(" + VTT_TIME + r")\s+-->\s+(" + VTT_TIME + r")", lines[timing])
        if not match:
            raise Error("invalid_captions", "Malformed VTT timestamp.")
        start, end = (seconds(v) for v in match.groups())
        payload = lines[timing + 1:]
        # Only de-roll cues with explicit YouTube rolling-caption evidence.
        rolling = "position:" in lines[timing] and any(re.search(r"<" + VTT_TIME + r">", line) for line in payload)
        clean = [normalize(html.unescape(VTT_TAG.sub("", line))) for line in payload]
        clean = [line for line in clean if line]
        original = clean[:]
        if rolling and start <= previous_end + 0.05:
            for size in range(min(len(previous_lines), len(clean)), 0, -1):
                if previous_lines[-size:] == clean[:size]:
                    clean = clean[size:]
                    break
        text = normalize(" ".join(clean))
        if text:
            cues.append({"start": start, "end": end, "text": text})
        previous_lines, previous_end = original, end
    return validate_cues(cues)


def validate_cues(cues):
    for c in cues:
        if not math.isfinite(c["start"]) or not math.isfinite(c["end"]) or c["start"] < 0 or c["end"] < c["start"]:
            raise Error("invalid_captions", "Invalid caption timing.")
    # Preserve repetitions. Prefer occasional display overlap to lost speech.
    return sorted(cues, key=lambda c: c["start"])


def passages(cues):
    result, current = [], None
    for cue in cues:
        if current and (len(current["text"]) + len(cue["text"]) > 480 or cue["start"] - current["start"] >= 30 or cue["start"] - current["end"] > 3):
            result.append(current)
            current = None
        if current is None:
            current = dict(cue)
        else:
            current["end"] = max(current["end"], cue["end"])
            current["text"] += " " + cue["text"]
    if current:
        result.append(current)
    return result


CHAPTER_LINE = re.compile(
    r"^\s*(?:[-*•]+\s+)?(?:\d{1,2}[.)]\s+)?\(?"
    r"((?:\d{1,2}:)?\d{1,2}:\d{2})(?!\d)\)?\s*(?:[-–—:|]\s*)*(.*?)\s*$"
)


def finish_chapters(items, duration=None):
    cleaned, seen = [], set()
    for start, title, end in items:
        if start in seen or not math.isfinite(start) or start < 0:
            continue
        if duration is not None and start > duration:
            continue
        seen.add(start)
        cleaned.append({"start": start, "title": title, "end": end})
    cleaned.sort(key=lambda c: c["start"])
    for i, ch in enumerate(cleaned):
        nxt = cleaned[i + 1]["start"] if i + 1 < len(cleaned) else duration
        end = ch["end"]
        if end is None or (nxt is not None and end > nxt):
            ch["end"] = nxt if nxt is not None else ch["start"]
        elif end < ch["start"]:
            ch["end"] = ch["start"]
    return cleaned


def parse_chapters(description, duration=None):
    if not description:
        return []
    best, run = [], []
    for line in description.splitlines():
        match = CHAPTER_LINE.match(line)
        if not match:
            continue
        try:
            start = seconds(match.group(1))
        except ValueError:
            continue
        title = normalize(match.group(2)).strip(" -–—:|")
        if not title or title.lower() in {"am", "pm"} or re.match(r"https?://", title, re.I):
            continue
        if run and start < run[-1][0]:
            if len(run) > len(best):
                best = run
            run = []
        run.append((start, title, None))
    if len(run) > len(best):
        best = run
    return finish_chapters(best, duration) if len(best) >= 2 else []


def chapters_from_player(info, description, duration):
    items = []
    raw = info.get("chapters")
    if isinstance(raw, list):
        for ch in raw:
            if not isinstance(ch, dict):
                items = []
                break
            title = normalize(str(ch.get("title") or ""))
            try:
                start = float(ch.get("start_time"))
                end = ch.get("end_time")
                end = float(end) if end is not None else None
            except (TypeError, ValueError):
                items = []
                break
            if not title or not math.isfinite(start) or start < 0:
                continue
            if end is not None and (not math.isfinite(end) or end < start):
                end = None
            items.append((start, title, end))
    result = finish_chapters(items, duration) if items else []
    return result or parse_chapters(description, duration)


def public_chapters(row):
    chapters = []
    raw = row.get("chapters_json")
    if raw:
        try:
            loaded = json.loads(raw)
            if isinstance(loaded, list):
                chapters = loaded
        except (TypeError, ValueError):
            chapters = []
    if not chapters:
        chapters = parse_chapters(row.get("description") or "", row.get("duration_s"))
    return [dict(c, url=url_for(row["id"], c["start"])) for c in chapters]


def transcript(cues):
    return "\n\n".join(f"[{timestamp(c['start'])}] {c['text']}" for c in passages(cues))


def run_ytdlp(args):
    binary = shutil.which("yt-dlp")
    if not binary:
        raise Error("missing_dependency", "Install yt-dlp: brew install yt-dlp (macOS) or pipx install yt-dlp (Linux).")
    try:
        p = subprocess.run([binary, "--ignore-config", "--no-playlist", "--skip-download", "--no-progress", "--socket-timeout", "15", "--retries", "2", "--extractor-retries", "1", "--ignore-no-formats-error", *args], capture_output=True, text=True, timeout=180)
    except subprocess.TimeoutExpired:
        raise Error("timeout", "YouTube request timed out. Try again later.")
    if p.returncode:
        detail = (p.stderr or p.stdout).strip()
        if "429" in detail or "Too Many Requests" in detail:
            raise Error("rate_limited", "YouTube rate-limited this request. Wait before retrying; cookies are not a guaranteed fix.")
        if any(s in detail.lower() for s in ("sign in", "login", "cookies", "private video", "confirm your age")):
            raise Error("authentication_required", "YouTube requires authentication. If you consent to browser-cookie access, use --cookies-from-browser BROWSER.")
        raise Error("download_failed", detail[-1500:] or "yt-dlp failed.")
    return p.stdout


def choose_track(info, language=None):
    manual = info.get("subtitles") or {}
    auto = info.get("automatic_captions") or {}
    candidates = []
    for source, tracks in (("manual", manual), ("auto", auto)):
        for lang, formats in tracks.items():
            if lang == "live_chat" or not LANG.fullmatch(lang) or not any(f.get("ext") in ("json3", "vtt") for f in formats):
                continue
            candidates.append((lang, source))
    preferred = [language, language + "-orig"] if language else ["en", "en-US", "en-GB", "en-orig"]
    if language:
        candidates = [c for c in candidates if c[0] in preferred]
    def rank(c):
        lang, source = c
        return (0 if lang in preferred else 1, 0 if source == "manual" else 1,
                0 if lang.endswith("-orig") else 1, preferred.index(lang) if lang in preferred else 99, lang)
    # Avoid falling back to an arbitrary machine translation.
    candidates = [c for c in candidates if c[1] == "manual" or c[0] in preferred or c[0].endswith("-orig") or c[0] == info.get("language")]
    if not candidates:
        available = ", ".join(sorted(set(manual) | {k for k in auto if k.endswith("-orig")})) or "none"
        raise Error("captions_unavailable", f"No suitable captions{(' for ' + language) if language else ''}. Available original/manual tracks: {available}. Caption-less videos are not supported.")
    return sorted(candidates, key=rank)[0]


def fetch(key, language, browser):
    cookies = ["--cookies-from-browser", browser] if browser else []
    info = json.loads(run_ytdlp(["--dump-single-json", *cookies, "--", url_for(key)]))
    if info.get("id") != key or info.get("_type") == "playlist":
        raise Error("invalid_video", "YouTube returned an unexpected video.")
    lang, source = choose_track(info, language)
    with tempfile.TemporaryDirectory(prefix="ytmd-") as tmp:
        # Exactly one track; no user yt-dlp config, media downloads or exec hooks.
        run_ytdlp(["--write-subs" if source == "manual" else "--write-auto-subs", "--sub-langs", re.escape(lang), "--sub-format", "json3/vtt", "--no-simulate", "-o", str(Path(tmp) / "captions.%(ext)s"), *cookies, "--", url_for(key)])
        files = sorted(p for p in Path(tmp).iterdir() if p.suffix in (".json3", ".vtt"))
        if len(files) != 1:
            raise Error("captions_unavailable", "Expected one caption file; none or multiple were returned. Update yt-dlp and retry.")
        raw = files[0].read_text(encoding="utf-8-sig")
        fmt = files[0].suffix[1:]
        cues = parse_json3(raw) if fmt == "json3" else parse_vtt(raw)
    if not cues:
        raise Error("invalid_captions", "YouTube returned empty captions.")
    uploaded = info.get("upload_date") or ""
    if re.fullmatch(r"\d{8}", uploaded):
        uploaded = f"{uploaded[:4]}-{uploaded[4:6]}-{uploaded[6:]}"
    description = info.get("description") or ""
    duration = info.get("duration")
    chapters = chapters_from_player(info, description, duration)
    return dict(id=key, title=info.get("title") or key, channel=info.get("channel") or info.get("uploader") or "", url=url_for(key), uploaded_at=uploaded, duration_s=duration, description=description, captions=source, lang=lang, ingested_at=datetime.now(timezone.utc).isoformat(), transcript=transcript(cues), cues_json=json.dumps(cues, ensure_ascii=False), raw_captions=raw, caption_format=fmt, chapters_json=json.dumps(chapters, ensure_ascii=False) if chapters else None)


# SQLite is canonical; markdown is a recoverable, generated view.
VIDEO_SCHEMA = """CREATE TABLE IF NOT EXISTS videos (
    id TEXT PRIMARY KEY, title TEXT NOT NULL, channel TEXT, url TEXT NOT NULL,
    uploaded_at TEXT, duration_s INTEGER, description TEXT, captions TEXT NOT NULL,
    lang TEXT, ingested_at TEXT NOT NULL, transcript TEXT NOT NULL,
    cues_json TEXT, raw_captions TEXT, caption_format TEXT, chapters_json TEXT)"""


def legacy_cues(row):
    chunks = re.split(r"\[(\d+(?::\d+){1,2})\]\s*", row["transcript"])
    cues = []
    if chunks[0].strip():
        cues.append(dict(start=0.0, end=0.0, text=chunks[0].strip()))
    for i in range(1, len(chunks) - 1, 2):
        cues.append(dict(start=seconds(chunks[i]), end=seconds(chunks[i]), text=chunks[i + 1].strip()))
    for i, c in enumerate(cues):
        c["end"] = max(c["start"], cues[i + 1]["start"] if i + 1 < len(cues) else row["duration_s"] or c["start"])
    return cues


def insert_passages(conn, key, cues):
    conn.execute("DELETE FROM passages WHERE video_id = ?", (key,))
    conn.executemany("INSERT INTO passages(video_id,start,end,text) VALUES (?,?,?,?)", [(key, c["start"], c["end"], c["text"]) for c in passages(cues)])


def migrate_v1(conn):
    conn.execute(VIDEO_SCHEMA)
    columns = {r[1] for r in conn.execute("PRAGMA table_info(videos)")}
    for col in ("cues_json", "raw_captions", "caption_format", "chapters_json"):
        if col not in columns:
            conn.execute(f"ALTER TABLE videos ADD COLUMN {col} TEXT")
    conn.execute("CREATE TABLE passages (id INTEGER PRIMARY KEY, video_id TEXT NOT NULL REFERENCES videos(id) ON DELETE CASCADE, start REAL NOT NULL, end REAL NOT NULL, text TEXT NOT NULL)")
    conn.execute("CREATE INDEX passages_video ON passages(video_id,start)")
    conn.execute("CREATE VIRTUAL TABLE passages_fts USING fts5(text, content='passages', content_rowid='id', tokenize='unicode61')")
    conn.execute("CREATE TRIGGER passages_ai AFTER INSERT ON passages BEGIN INSERT INTO passages_fts(rowid,text) VALUES(new.id,new.text); END")
    conn.execute("CREATE TRIGGER passages_ad AFTER DELETE ON passages BEGIN INSERT INTO passages_fts(passages_fts,rowid,text) VALUES('delete',old.id,old.text); END")
    for row in conn.execute("SELECT * FROM videos").fetchall():
        cues = legacy_cues(row)
        conn.execute("UPDATE videos SET cues_json=?, caption_format='legacy', captions='unknown' WHERE id=?", (json.dumps(cues, ensure_ascii=False), row["id"]))
        insert_passages(conn, row["id"], cues)
    conn.execute("DROP TABLE IF EXISTS videos_fts")
    conn.execute("PRAGMA user_version=1")


def migrate_v2(conn):
    columns = {r[1] for r in conn.execute("PRAGMA table_info(videos)")}
    if "chapters_json" not in columns:
        conn.execute("ALTER TABLE videos ADD COLUMN chapters_json TEXT")
    for row in conn.execute("SELECT id, description, duration_s, chapters_json FROM videos").fetchall():
        if row["chapters_json"]:
            continue
        chapters = parse_chapters(row["description"] or "", row["duration_s"])
        if chapters:
            conn.execute("UPDATE videos SET chapters_json=? WHERE id=?", (json.dumps(chapters, ensure_ascii=False), row["id"]))
    conn.execute("PRAGMA user_version=2")


def connect():
    root = library()
    root.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(root / "ytmd.db", timeout=30)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys=ON")
    version = conn.execute("PRAGMA user_version").fetchone()[0]
    if version > SCHEMA:
        conn.close()
        raise Error("newer_database", "This library requires a newer ytmd. Update the CLI.")
    if version == SCHEMA:
        return conn
    exists = conn.execute("SELECT 1 FROM sqlite_master WHERE name='videos'").fetchone()
    try:
        if exists and version == 0:
            backup = root / "ytmd.pre-v0.2.db"
            if not backup.exists():
                with closing(sqlite3.connect(backup)) as target:
                    conn.backup(target)
        with conn:
            conn.execute("BEGIN IMMEDIATE")
            # Another process may have migrated while we waited for its lock.
            version = conn.execute("PRAGMA user_version").fetchone()[0]
            if version == SCHEMA:
                return conn
            if version == 0:
                migrate_v1(conn)
                version = 1
            if version < 2:
                migrate_v2(conn)
    except Exception:
        conn.close()
        raise
    return conn


def save(conn, row):
    cols = list(row)
    with conn:
        conn.execute(f"INSERT INTO videos ({','.join(cols)}) VALUES ({','.join('?' for _ in cols)}) ON CONFLICT(id) DO UPDATE SET " + ','.join(f"{c}=excluded.{c}" for c in cols if c != "id"), [row[c] for c in cols])
        insert_passages(conn, row["id"], json.loads(row["cues_json"]))


def markdown(row):
    meta = {k: row[k] for k in ("title", "id", "url", "channel", "uploaded_at", "duration_s", "captions", "lang", "ingested_at", "caption_format")}
    lines = ["---", *[f"{k}: {json.dumps(v, ensure_ascii=False)}" for k, v in meta.items()], "source: youtube", "---", "", f"# {normalize(row['title'])}", "", row["url"], ""]
    chapters = public_chapters(row)
    if chapters:
        lines += ["## Chapters", ""]
        lines += [f"[{timestamp(c['start'])}]({c['url']}) {c['title']}" for c in chapters]
        lines += [""]
    lines += ["## Transcript", ""]
    if row["caption_format"] == "legacy":
        lines += ["> Imported from v0.1; timing is approximate and original caption data is unavailable. Re-ingest with --force to recover source captions.", ""]
    for c in passages(json.loads(row["cues_json"])):
        # Escape Markdown punctuation so code notation remains visible when rendered.
        text = html.escape(c["text"], quote=False)
        text = re.sub(r"([\\`*_{}\[\]])", r"\\\1", text)
        lines += [f"[{timestamp(c['start'])}]({url_for(row['id'], c['start'])}) {text}", ""]
    return "\n".join(lines)


def write_markdown(row, dest=None):
    if not ID.fullmatch(row["id"]):
        raise Error("invalid_video", "Invalid stored video ID; refusing to write a filename.")
    root = Path(dest).expanduser().resolve() if dest else library()
    root.mkdir(parents=True, exist_ok=True)
    path = root / f"{row['id']}.md"
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=root, prefix=".ytmd-", delete=False) as f:
            temporary = Path(f.name)
            f.write(markdown(row))
            f.flush()
            os.fsync(f.fileno())
        os.replace(temporary, path)
        # Remove old generated slug filenames only after the replacement succeeds.
        for old in root.glob(f"{row['id']}-*.md"):
            old.unlink()
    finally:
        if temporary and temporary.exists():
            temporary.unlink()
    return str(path)


def resolve(conn, key):
    try:
        key = video_id(key)
    except (Error, ValueError):
        pass
    row = conn.execute("SELECT * FROM videos WHERE id=?", (key,)).fetchone()
    if row:
        return dict(row)
    # Literal title/prefix lookup, never SQL wildcard semantics.
    escaped = key.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
    rows = conn.execute("SELECT * FROM videos WHERE id LIKE ? ESCAPE '\\' OR title LIKE ? ESCAPE '\\' LIMIT 11", (escaped + "%", "%" + escaped + "%")).fetchall()
    if len(rows) > 1:
        raise Error("ambiguous_video", "Use an exact video ID: " + ", ".join(r["id"] for r in rows))
    if not rows:
        raise Error("not_found", f"No saved video matches {key!r}.")
    return dict(rows[0])


def output(data, args, text):
    print(json.dumps(data, ensure_ascii=False, indent=2) if args.json else text)


def ensure_saved(args):
    """Shared ingestion for add/get; return data without contaminating stdout."""
    key = video_id(args.url)
    with closing(connect()) as conn:
        existing = conn.execute("SELECT * FROM videos WHERE id=?", (key,)).fetchone()
    if existing and not args.force:
        if args.lang and existing["lang"] not in (args.lang, args.lang + "-orig"):
            raise Error("language_mismatch", f"Saved track is {existing['lang']}, not {args.lang}. Use --force to replace it, or omit --lang to read the saved track.")
        row, status = dict(existing), "existing"
    else:
        if not args.json:
            print(f"Fetching {url_for(key)} …", file=sys.stderr)
        row, status = fetch(key, args.lang, args.cookies_from_browser), "saved"
        with closing(connect()) as conn:
            save(conn, row)
    try:
        path = write_markdown(row)
    except OSError as e:
        raise Error("export_failed", f"Transcript is saved in SQLite, but markdown export failed: {e}. Repair with: ytmd export")
    return row, dict(status=status, id=key, title=row["title"], url=row["url"], path=path, captions=row["captions"], lang=row["lang"], duration_s=row["duration_s"], chapters=public_chapters(row))


def cmd_add(args):
    row, data = ensure_saved(args)
    hint = f"Outline: ytmd info {row['id']}" if data["chapters"] else f"Read: ytmd show {row['id']} --from 0:00 --to 1:00"
    output(data, args, f"{data['status']}: {row['title']}\n{data['path']}\n{hint}")


def window(cues, start, end=None):
    # Include complete cues overlapping the window; zero-duration cues count at their start.
    return [c for c in cues if (c["end"] > start or c["start"] >= start) and (end is None or c["start"] < end)]


def check_range(args):
    if args.to is not None and args.to <= args.start:
        raise Error("invalid_range", "--to must be later than --from.")


def print_transcript(row, args, extra=None):
    cues = window(json.loads(row["cues_json"]), args.start, args.to)
    selected = [dict(c, url=url_for(row["id"], c["start"])) for c in passages(cues)]
    if args.plain:
        print("\n\n".join(c["text"] for c in selected))
        return
    remaining = (row["duration_s"] or 0) - (args.start or 0)
    if not args.json and args.to is None and remaining >= 600:
        print(f"ytmd: {timestamp(remaining)} transcript. Outline: ytmd info {row['id']}", file=sys.stderr)
    data = {k: row[k] for k in ("id", "title", "url", "channel", "lang", "captions", "caption_format", "duration_s")}
    data.update(path=str(library() / f"{row['id']}.md"), chapters=public_chapters(row), passages=selected)
    if extra:
        data.update(extra)
    text = f"# {row['title']}\n{row['url']}\n\n" + "\n\n".join(f"[{timestamp(c['start'])}] {c['text']}" for c in selected)
    output(data, args, text)


def cmd_get(args):
    check_range(args)  # Invalid requests must not trigger a network fetch or save.
    row, data = ensure_saved(args)
    print_transcript(row, args, dict(status=data["status"]))


def cmd_search(args):
    tokens = re.findall(r"\w+", " ".join(args.query), re.UNICODE)
    if not tokens:
        raise Error("invalid_query", "Enter at least one search word.")
    if args.match == "phrase":
        query = '"' + " ".join(tokens) + '"'
    else:
        joiner = " AND " if args.match == "all" else " OR "
        query = joiner.join('"' + t + '"' for t in dict.fromkeys(tokens))
    with closing(connect()) as conn:
        key = resolve(conn, args.video)["id"] if args.video else None
        rows = conn.execute("""SELECT v.id AS video_id,v.title,v.captions,v.lang,v.caption_format,p.start,p.end,p.text,
            bm25(passages_fts) AS score FROM passages_fts
            JOIN passages p ON p.id=passages_fts.rowid JOIN videos v ON v.id=p.video_id
            WHERE passages_fts MATCH ? AND (? IS NULL OR v.id=?)
            ORDER BY score,p.video_id,p.start LIMIT ?""", (query, key, key, args.limit)).fetchall()
        results = [dict(r, url=url_for(r["video_id"], r["start"])) for r in rows]
        if args.context:
            sources = {}
            for r in results:
                key = r["video_id"]
                if key not in sources:
                    sources[key] = json.loads(conn.execute("SELECT cues_json FROM videos WHERE id=?", (key,)).fetchone()[0])
                nearby = window(sources[key], max(0, r["start"] - args.context), r["end"] + args.context)
                if nearby:
                    r["context"] = dict(start=nearby[0]["start"], end=max(c["end"] for c in nearby), text=transcript(nearby), url=url_for(key, nearby[0]["start"]))
    output(results, args, "\n\n".join(f"{r['video_id']}  {r['title']} [{timestamp(r['start'])}]\n{r.get('context', {}).get('text', r['text'])}\n{r['url']}" for r in results) or "No matches. Try fewer keywords or --match any; search is lexical, not semantic.")


def cmd_show(args):
    check_range(args)
    with closing(connect()) as conn:
        row = resolve(conn, args.video)
    print_transcript(row, args)


def cmd_info(args):
    with closing(connect()) as conn:
        row = resolve(conn, args.video)
    chapters = public_chapters(row)
    data = {k: row[k] for k in ("id", "title", "url", "channel", "uploaded_at", "duration_s", "captions", "lang", "caption_format", "ingested_at")}
    data.update(path=str(library() / f"{row['id']}.md"), chapters=chapters)
    details = " · ".join(x for x in (row["channel"] or None, timestamp(row["duration_s"]) if row["duration_s"] is not None else None, f"{row['captions']} {row['lang']}".strip()) if x)
    lines = [f"# {row['title']}", row["url"], "", details]
    if chapters:
        lines += ["", "Chapters:"] + [f"  {timestamp(c['start'])}  {c['title']}" for c in chapters]
    else:
        lines += ["", f"No chapters found. Read: ytmd show {row['id']} --from 0:00 --to 1:00"]
    output(data, args, "\n".join(lines))


def cmd_list(args):
    literal = (args.query or "").replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
    term = "%" + literal + "%"
    with closing(connect()) as conn:
        rows = [dict(r) for r in conn.execute("""SELECT id,title,channel,url,lang,captions,duration_s,uploaded_at,ingested_at FROM videos
            WHERE title LIKE ? ESCAPE '\\' OR channel LIKE ? ESCAPE '\\' OR id LIKE ? ESCAPE '\\'
            ORDER BY ingested_at DESC,id LIMIT ? OFFSET ?""", (term, term, term, args.limit, args.offset))]
    for row in rows:
        row["path"] = str(library() / f"{row['id']}.md")
    output(rows, args, "\n".join(f"{r['id']}  {r['title']}\n  {r['channel'] or 'Unknown channel'} · {timestamp(r['duration_s']) if r['duration_s'] is not None else 'Unknown duration'}" for r in rows) or "No saved videos match this page. Run: ytmd list or ytmd URL")


def cmd_export(args):
    with closing(connect()) as conn:
        rows = [dict(r) for r in conn.execute("SELECT * FROM videos")]
    files = [write_markdown(row, args.directory) for row in rows]
    output(dict(files=files), args, f"Exported {len(files)} markdown files.")


def cmd_rm(args):
    if not ID.fullmatch(args.video):
        raise Error("invalid_video", "Deletion requires the exact 11-character video ID.")
    with closing(connect()) as conn:
        row = resolve(conn, args.video)
        with conn:
            conn.execute("DELETE FROM videos WHERE id=?", (row["id"],))
    for path in [library() / f"{row['id']}.md", *library().glob(f"{row['id']}-*.md")]:
        if path.exists():
            path.unlink()
    output(dict(status="removed", id=row["id"]), args, f"Removed {row['id']}")


def cmd_doctor(args):
    with closing(sqlite3.connect(":memory:")) as conn:
        try:
            conn.execute("CREATE VIRTUAL TABLE test USING fts5(text)")
            fts = True
        except sqlite3.OperationalError:
            fts = False
    data = dict(version=VERSION, python=sys.version.split()[0], fts5=fts, yt_dlp=shutil.which("yt-dlp"), library=str(library()))
    data["ok"] = bool(fts and data["yt_dlp"] and sys.version_info >= (3, 9))
    output(data, args, "\n".join(f"{k}: {v}" for k, v in data.items()))
    return 0 if data["ok"] else 1


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise Error("usage", message)


def positive(value):
    try:
        number = int(value)
        if not 1 <= number <= 100:
            raise ValueError()
        return number
    except ValueError:
        raise argparse.ArgumentTypeError("limit must be an integer between 1 and 100")


def time_arg(value):
    try:
        return seconds(value)
    except ValueError:
        raise argparse.ArgumentTypeError("use seconds, MM:SS or HH:MM:SS")


def language_arg(value):
    if not LANG.fullmatch(value):
        raise argparse.ArgumentTypeError("specify one language code, e.g. en or de (not a regex or 'all')")
    if value == "all":
        raise argparse.ArgumentTypeError("choose one language, not 'all'")
    return value


def nonnegative(value):
    try:
        number = int(value)
        if not 0 <= number <= 1000000000:
            raise ValueError()
        return number
    except ValueError:
        raise argparse.ArgumentTypeError("use a non-negative integer up to 1000000000")


def context_arg(value):
    number = nonnegative(value)
    if number > 120:
        raise argparse.ArgumentTypeError("context must be between 0 and 120 seconds")
    return number


def parser():
    p = Parser(description=__doc__, epilog="Start: ytmd get URL | Outline: ytmd info ID | Search: ytmd search WORDS | Read: ytmd show ID --from 0:00 --to 1:00. Library: ~/ytmd (override YTMD_DIR).")
    p.add_argument("--version", action="version", version=f"ytmd {VERSION}")
    sub = p.add_subparsers(dest="command", required=True)
    for name, help_text, handler in [("add", "save a video's captions", cmd_add), ("get", "save if needed, then print the transcript", cmd_get), ("search", "search timestamped passages", cmd_search), ("show", "read a video or time window", cmd_show), ("info", "metadata and chapters", cmd_info), ("list", "list saved videos", cmd_list), ("export", "rebuild markdown from SQLite", cmd_export), ("rm", "delete a saved video", cmd_rm), ("doctor", "check local dependencies", cmd_doctor), ("path", "print library location", None)]:
        s = sub.add_parser(name, help=help_text, description=help_text)
        formats = s.add_mutually_exclusive_group()
        formats.add_argument("--json", action="store_true", help="machine-readable output (errors too)")
        if name in ("get", "show"):
            formats.add_argument("--plain", action="store_true", help="text only, without metadata or timestamps")
            s.add_argument("--from", dest="start", type=time_arg, default=0.0)
            s.add_argument("--to", type=time_arg)
        s.set_defaults(handler=handler)
        if name in ("add", "get"):
            s.add_argument("url")
            s.add_argument("--lang", type=language_arg, default=os.environ.get("YTMD_LANG"), help="one language; default: English then original/manual captions")
            s.add_argument("--force", action="store_true", help="replace saved captions")
            s.add_argument("--cookies-from-browser", help="explicit consent to read cookies from this browser")
        elif name == "search":
            s.add_argument("query", nargs="+")
            s.add_argument("--video", help="restrict to this video ID/title")
            s.add_argument("-n", "--limit", type=positive, default=10)
            s.add_argument("--match", choices=("all", "any", "phrase"), default="all", help="match all query words (default), any of them, or the words as one phrase")
            s.add_argument("--context", type=context_arg, default=0, metavar="SECONDS", help="include 0–120 seconds around each matched passage")
        elif name == "list":
            s.add_argument("query", nargs="?", help="filter by title, channel, or ID (literal substring)")
            s.add_argument("-n", "--limit", type=positive, default=50)
            s.add_argument("--offset", type=nonnegative, default=0)
        elif name in ("show", "rm", "info"):
            s.add_argument("video")
        elif name == "export":
            s.add_argument("directory", nargs="?")
    return p


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    try:
        if not argv:
            parser().print_help()
            return 0
        if argv[0] == "help":
            argv = argv[1:] + ["--help"]
        if argv[0].startswith(("https://", "http://")) or ID.fullmatch(argv[0]):
            argv.insert(0, "add")
        args = parser().parse_args(argv)
        if args.command == "path":
            output(dict(library=str(library()), database=str(library() / "ytmd.db")), args, str(library()))
            return 0
        return args.handler(args) or 0
    except Error as e:
        error = e
    except BrokenPipeError:
        return 0
    except (OSError, sqlite3.Error, ValueError, KeyError, TypeError) as e:
        error = Error("operation_failed", str(e))
    except KeyboardInterrupt:
        error = Error("interrupted", "Cancelled.")
    data = {"error": {"code": error.code, "message": error.message}}
    print(json.dumps(data, ensure_ascii=False) if "--json" in argv else f"ytmd: {error.message}", file=sys.stderr)
    return 2 if error.code == "usage" else 1


if __name__ == "__main__":
    sys.exit(main())
